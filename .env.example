# Chave pública de cliente: usada apenas no mapa base do Google Maps JavaScript API.
# Restrinja por HTTP referrers e Maps JavaScript API; não registre valores reais no Git.
# Caminhos da demo são snapshots locais; Routes API não é necessária.
VITE_GOOGLE_MAPS_API_KEY=
# Opcional: usa DEMO_MAP_ID quando vazio.
VITE_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Vazio = demo local. Configure a URL da API existente para modo conectado + SSE.
# Exemplo local: http://127.0.0.1:8000 (reinicie o Vite depois de alterar).
# Não coloque tokens/credenciais nesta URL pública de cliente.
VITE_API_BASE_URL=
